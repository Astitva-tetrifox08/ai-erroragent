# GitHub - Fine-Grained PAT with read access to org repos
GITHUB_TOKEN=ghp_your_token_here
GITHUB_ORG=NVX-ai

# Microsoft Teams - Power Automate webhook URL for the notification channel
TEAMS_WEBHOOK_URL=https://your-webhook-url-here

# GitHub Models API - Classic PAT (no scopes needed)
GITHUB_MODELS_TOKEN=ghp_your_classic_token_here

# Optional
LOG_LEVEL=INFO
